#!/bin/bash
# Ajar privileged helper: turn OFF passwordless sudo (sudo asks for a password again).
#
#   pkexec /usr/libexec/ajar/disable   remove the calling user's rule. Polkit allows this
#                                      without a password only from the active local session.
#   (as root) disable --all            remove every Ajar rule. Used by uninstall and the
#                                      package's prerm. Refused when started through pkexec.
#
# It only ever deletes files matching /etc/sudoers.d/90-ajar-<valid user name>.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
readonly DIR=/etc/sudoers.d

die() { echo "ajar: $*" >&2; logger -t ajar -p auth.warning "disable refused: $*" || true; exit 1; }
[[ $EUID -eq 0 ]] || die "must run as root"

if [[ $# -eq 1 && "$1" == "--all" ]]; then
    [[ -z "${PKEXEC_UID:-}" ]] || die "--all is not available through pkexec"
    shopt -s nullglob
    for f in "$DIR"/90-ajar-*; do
        [[ "${f##*/}" =~ ^90-ajar-[a-z_][a-z0-9_-]{0,31}$ ]] || continue
        rm -f -- "$f"
        logger -t ajar -p auth.notice "passwordless sudo DISABLED (${f##*/} removed by uninstall)"
    done
    exit 0
fi

[[ $# -eq 0 ]] || die "unexpected arguments"
uid="${PKEXEC_UID:-}"
[[ "$uid" =~ ^[0-9]+$ ]] || die "must be started through pkexec (or use --all as root)"
user="$(getent passwd "$uid" | cut -d: -f1)"
[[ "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "unsupported user name for uid $uid"

rm -f -- "$DIR/90-ajar-$user"
logger -t ajar -p auth.notice "passwordless sudo DISABLED for $user (uid $uid)"
